# Database - Turso (production)
DATABASE_URL="libsql://tinori-shop-nguyenvantrung123.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Admin account (dùng khi seed database)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-password-here"

# Gmail SMTP - cần App Password (không phải mật khẩu thường)
# Bật 2FA → Google Account → Security → App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
